# GeoAgri AI Frontend Configuration (PRD v3.0 §13)

# MapLibre vector style URL (optional; fallback to built-in basemaps)
VITE_MAP_STYLE_URL=

# Satellite raster tile template URL (optional; defaults to Esri World Imagery)
VITE_SATELLITE_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Geocoder endpoint URL (optional; e.g. Photon or self-hosted Pelias)
VITE_GEOCODER_URL=

# Enable 3D terrain mesh and hillshading on MapLibre (default false)
VITE_ENABLE_3D_TERRAIN=false

# Sales Demo Mode flag (default false)
VITE_DEMO_MODE=false

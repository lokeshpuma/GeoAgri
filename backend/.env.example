# GeoAgri AI Environment Configuration (PRD v3.1)

# --- behaviour
ENV=development
ALLOW_SYNTHETIC_DATA=false          # dev-only escape hatch
GEE_MOCK_FALLBACK=false             # default flipped to false
LOG_LEVEL=INFO

# --- Google Earth Engine (noncommercial project)
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=                # optional; service account email
GEE_PRIVATE_KEY_PATH=               # path to service account JSON key

# --- weather
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_ENABLED=true

# --- soil (REST API paused; use files/GEE)
SOILGRIDS_SOURCE=gee              # gee | local
SOILGRIDS_LOCAL_DIR=backend/ml/data/raw/external/soil/soilgrids

# --- land records & intelligence (PRD v2.0 §8, v2.1 M20)
KSRSAC_API_BASE_URL=
KSRSAC_API_KEY=
BHUVAN_WMS_ENDPOINT=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
ENABLE_BHUVAN_LIVE_QUERY=true
MAX_UPLOAD_SIZE_MB=15

# --- detection & gating flags (PRD v2.1 §5A.7, §19.4)
LAND_DETECTION_MODE=enforce       # off | shadow | enforce
LAND_GATE_MODE=enforce            # off | shadow | enforce
AREA_CHECK_ACRES=0.7
OPENFREEMAP_TILEJSON=https://tiles.openfreemap.org/planet
OVERPASS_URL=https://overpass-api.de/api/interpreter
DETECTION_PER_SOURCE_TIMEOUT_S=6.0
DETECTION_TOTAL_BUDGET_S=8.0
DETECTION_CACHE_TTL_S=86400
UPLOAD_RETENTION_SECONDS=0

# --- optional credentials
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
DATA_GOV_IN_API_KEY=
WDPA_API_TOKEN=

# --- spatial DB
DATABASE_URL=postgresql+psycopg://geoagri:geoagri@localhost:5432/geoagri

# --- polite clients
HTTP_USER_AGENT=GeoAgri/1.0 (contact: your-email@example.com)

# --- Fusion weights & cache (existing)
WEIGHT_LAND_SUITABILITY=0.20
WEIGHT_CROP_RECOMMENDATION=0.25
WEIGHT_IRRIGATION_COST=0.15
WEIGHT_YIELD=0.25
WEIGHT_CLIMATE_RISK=0.15
CACHE_TTL_SECONDS=86400

# Feature Flags
ADVANCED_MODELS_ENABLED=false

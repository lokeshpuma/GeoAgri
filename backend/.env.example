# GeoAgri AI Environment Configuration

# Service Environment
ENV=development
LOG_LEVEL=INFO

# Google Earth Engine Credentials
GEE_SERVICE_ACCOUNT=geoagri-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/path/to/gee_key.json
GEE_MOCK_FALLBACK=true

# External APIs
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# Fusion Weights (must sum to 1.0)
WEIGHT_LAND_SUITABILITY=0.20
WEIGHT_CROP_RECOMMENDATION=0.25
WEIGHT_IRRIGATION_COST=0.15
WEIGHT_YIELD=0.25
WEIGHT_CLIMATE_RISK=0.15

# Cache Settings
CACHE_TTL_SECONDS=86400

# Feature Flags
ADVANCED_MODELS_ENABLED=false
